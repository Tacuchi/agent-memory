    {
      "dot": "amber",
      "title": "Rules that hold",
      "items": [
        "The service listens on 127.0.0.1 only",
        "Hook, MCP server and web UI always go through the service",
        "The model never reaches the network in normal use",
        "The relay never reads or stores content"
      ]
    },
    {
      "dot": "cyan",
      "title": "Defaults",
      "items": [
        "Port 47821 (AGENT_MEMORY_PORT)",
        "Data in ~/.agent-memory (AGENT_MEMORY_HOME)",
        "Remote access is off",
        "The service does not stop by itself: agent-memory stop"
      ]
    },
    {
      "dot": "emerald",
      "title": "What it is not",
      "items": [
        "No language model: the model only computes vectors",
        "No sync: the remote link is read-only"
