{
  "name": "agent-memory",
  "version": "0.1.0",
  "description": "Memoria local para agentes de código: almacén SQLite con búsqueda híbrida, servicio local con token y servidor MCP.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-memory": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "model:measure": "tsc -p tsconfig.build.json && node --disable-warning=ExperimentalWarning dist/medir-modelos.js",
    "model:fetch": "tsc -p tsconfig.build.json && node --disable-warning=ExperimentalWarning dist/model-fetch.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
